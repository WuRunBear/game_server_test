{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "noEmitOnError": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "src": ["src"],
      "src/*": ["src/*"],
      "ai": ["src/ai"],
      "ai/*": ["src/ai/*"],
      "components": ["src/components"],
      "components/*": ["src/components/*"],
      "world": ["src/world"],
      "world/*": ["src/world/*"],
      "config": ["src/config"],
      "config/*": ["src/config/*"],
      "database": ["src/database"],
      "database/*": ["src/database/*"],
      "factories": ["src/factories"],
      "factories/*": ["src/factories/*"],
      "network": ["src/network"],
      "network/*": ["src/network/*"],
      "systems": ["src/systems"],
      "systems/*": ["src/systems/*"],
      "utils": ["src/utils"],
      "utils/*": ["src/utils/*"],
      "map": ["src/map"],
      "map/*": ["src/map/*"],
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "include": ["src"]
}
