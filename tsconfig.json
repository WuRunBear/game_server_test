{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "noEmitOnError": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "src": ["src"],
      "src/*": ["src/*"],
      "ai": ["framework/ai"],
      "ai/*": ["framework/ai/*"],
      "components": ["framework/components"],
      "components/*": ["framework/components/*"],
      "world": ["framework/world"],
      "world/*": ["framework/world/*"],
      "src/world": ["framework/world"],
      "config": ["framework/config"],
      "config/*": ["framework/config/*"],
      "network": ["framework/net"],
      "network/*": ["framework/net/*"],
      "systems": ["framework/systems"],
      "systems/*": ["framework/systems/*"],
      "utils": ["framework/utils"],
      "utils/*": ["framework/utils/*"],
      "map": ["framework/map"],
      "map/*": ["framework/map/*"],
      "src/metrics": ["framework/metrics"],
      "framework": ["framework/index.ts"],
      "framework/*": ["framework/*"],
      "database": ["framework"],
      "database/*": ["framework/*"],
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "include": ["src", "framework", "tools"]
}
