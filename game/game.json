{
  "id": "survival-island",
  "name": "荒岛求生",
  "worldview": { "theme": "survival" },
  "tickRate": 20,
  "world": { "tile": { "width": 16, "height": 16 } },
  "map": {
    "registry": "./maps/registry.json",
    "entityRules": "./maps/entity-rules.json",
    "ecosystems": "./ecosystems.json",
    "default": "island"
  },
  "systems": [
    { "id": "dayNight" },
    { "id": "environment" },
    { "id": "disaster" },
    { "id": "modifier" },
    { "id": "perception" },
    {
      "id": "ai",
      "config": {
        "pathfinding": {
          "enabled": true,
          "repathTicks": 20,
          "maxNodes": 16384,
          "waypointToleranceTiles": 0.35,
          "fleeGoalDistanceTiles": 8,
          "goalStabilityTiles": 1,
          "maxSearchesPerTick": 8
        }
      }
    },
    { "id": "physics" },
    { "id": "movement" },
    { "id": "entity-level" },
    { "id": "collision" },
    { "id": "projectile" },
    { "id": "combat" },
    { "id": "nest" },
    { "id": "raid" },
    { "id": "population" },
    { "id": "needDecay" },
    { "id": "inventory" },
    { "id": "spoil" },
    { "id": "gathering" },
    { "id": "stateMachine" },
    { "id": "interaction", "config": { "range": 24 } },
    {
      "id": "action",
      "config": {
        "actionsPath": "game/actions/actions.json",
        "intentActions": { "attack": "attack", "interact": "gather", "throw": "throw" }
      }
    },
    { "id": "equipment" },
    { "id": "progression" },
    { "id": "death" },
    { "id": "respawn" },
    { "id": "portal" },
    { "id": "quest" },
    { "id": "achievement", "config": { "checkIntervalTicks": 20 } },
    { "id": "timer" },
    { "id": "trigger" }
  ],
  "entities": "./entities/*.json",
  "behaviors": "./behaviors/*.json",
  "rules": "./rules/*.json",
  "items": "./items/*.json",
  "dialogues": "./dialogues/*.json",
  "quests": "./quests/*.json",
  "netSync": {
    "fields": [
      { "component": "Transform", "fields": ["x", "y", "rot", "scale"] },
      { "component": "Kind", "fields": ["value"] },
      { "component": "Health", "fields": ["current", "max"] },
      { "component": "Collider", "fields": ["shape", "radius"] },
      { "component": "Size", "fields": ["w", "h"] },
      { "component": "Needs", "tags": ["Player"], "fields": ["name", "current", "max"] },
      { "component": "Inventory", "tags": ["Player"], "fields": ["slots", "durability", "spoilAt"] },
      { "component": "Inventory", "tags": ["Container"], "fields": ["slots", "durability", "spoilAt"] },
      { "component": "ItemMeta", "tags": ["Item"], "fields": ["kind", "count", "durability", "spoilAt"] },
      { "component": "ResourceNode", "tags": ["Resource"], "fields": ["remaining", "max", "infinite"] },
      { "component": "Equipment", "fields": ["weaponSlot", "toolSlot", "armorSlot"] },
      { "component": "CraftingStation", "fields": ["stationType"] },
      { "component": "LightSource", "fields": ["radius", "fuelRemainingMs", "fuelInfinite"] },
      { "component": "Placeable", "fields": ["footprintW", "footprintH", "canCollide", "ownerNetworkId"] },
      { "component": "Structure", "fields": ["role", "connectLow", "connectHigh", "connectDir"] },
      { "component": "Passage", "fields": ["open"] },
      { "component": "GridOccupancy", "fields": ["cellX", "cellY", "cellW", "cellH", "cellLevel"] },
      { "component": "Portal", "fields": ["targetMap", "x", "y"] },
      { "component": "Dialogue", "tags": ["Player"], "fields": ["npcId", "treeId", "nodeId", "text", "optionText", "options"] },
      { "component": "DialogueSource", "tags": ["NPC"], "fields": ["treeId"] },
      { "component": "Quest", "tags": ["Player"], "fields": ["questId", "state", "count"] },
      { "component": "Relation", "tags": ["Player"], "fields": ["npcKind", "value"] },
      { "component": "Progression", "tags": ["Player"], "fields": ["totalXp", "level", "skills"] },
      { "component": "Achievements", "tags": ["Player"], "fields": ["unlocked"] },
      { "component": "Crafting", "tags": ["Player"], "fields": ["jobs"] },
      { "component": "Cooldown", "fields": ["remainingMs"] },
      { "component": "Attack", "fields": ["value", "range"] },
      { "component": "Defense", "fields": ["value"] },
      { "component": "Team", "fields": ["id"] },
      { "component": "Perception", "fields": ["visionRadius"] },
      { "component": "Velocity", "fields": ["vx", "vy"] },
      { "component": "Projectile", "fields": ["vx", "vy", "lifeMs", "radius", "damage"] },
      { "component": "StateMachine", "fields": ["state", "stateTick"] },
      { "component": "Modifiers", "fields": ["stats"] },
      { "component": "ExpiresAt", "fields": ["remainingTicks"] },
      { "component": "Ledger", "fields": ["entries"] },
      {
        "component": "Action",
        "tags": ["Player"],
        "fields": ["actionId", "startedTick", "durationTicks", "phase", "phaseIndex", "target", "dirX", "dirY"]
      },
      { "component": "Kind", "tags": ["Player"], "fields": ["exposure"] }
    ]
  }
}