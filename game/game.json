{
  "id": "survival-island",
  "name": "荒岛求生",
  "worldview": { "theme": "survival" },
  "tickRate": 20,
  "map": {
    "registry": "./maps/registry.json",
    "default": "generated-map"
  },
  "systems": [
    { "id": "dayNight" },
    { "id": "perception" },
    { "id": "ai" },
    { "id": "physics" },
    { "id": "movement" },
    { "id": "collision" },
    { "id": "combat" },
    { "id": "needDecay" },
    { "id": "spawning" },
    { "id": "inventory" },
    { "id": "gathering" },
    { "id": "interaction", "config": { "range": 24 } },
    { "id": "equipment" },
    { "id": "death" },
    { "id": "respawn" },
    { "id": "portal" },
    { "id": "quest" }
  ],
  "entities": "./entities/*.json",
  "behaviors": "./behaviors/*.json",
  "rules": "./rules/*.json",
  "spawns": "./spawns/*.json",
  "items": "./items/*.json",
  "dialogues": "./dialogues/*.json",
  "quests": "./quests/*.json",
  "netSync": {
    "fields": [
      { "component": "Transform", "fields": ["x", "y"] },
      { "component": "Health", "fields": ["current"] },
      { "component": "Collider", "fields": ["shape", "radius"] },
      { "component": "Size", "fields": ["w", "h"] },
      { "component": "Needs", "tags": ["Player"], "fields": ["name", "current", "max"] },
      { "component": "Inventory", "tags": ["Player"], "fields": ["slots"] },
      { "component": "ItemMeta", "tags": ["Item"], "fields": ["kind", "count"] },
      { "component": "ResourceNode", "tags": ["Resource"], "fields": ["remaining"] },
      { "component": "Equipment", "fields": ["weaponSlot", "toolSlot", "armorSlot"] },
      { "component": "CraftingStation", "fields": ["stationType"] },
      { "component": "LightSource", "fields": ["radius", "fuelRemainingMs"] },
      { "component": "Placeable", "fields": ["footprintW", "footprintH", "canCollide"] },
      { "component": "GridOccupancy", "fields": ["cellX", "cellY", "cellW", "cellH"] },
      { "component": "Portal", "fields": ["targetMap", "x", "y"] },
      { "component": "Dialogue", "tags": ["Player"], "fields": ["npcId", "treeId", "nodeId", "options"] },
      { "component": "DialogueSource", "tags": ["NPC"], "fields": ["treeId"] },
      { "component": "Quest", "tags": ["Player"], "fields": ["questId", "state", "count"] },
      { "component": "Relation", "tags": ["Player"], "fields": ["npcKind", "value"] }
    ]
  }
}