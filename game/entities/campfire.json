{
  "kind": "campfire",
  "components": {
    "Size": { "w": 24, "h": 24 },
    "Collider": { "shape": 1, "halfW": 12, "halfH": 12 },
    "CraftingStation": { "stationType": 1 },
    "LightSource": { "radiusTiles": 5, "fuelRemainingMs": 1000000000 },
    "Placeable": { "footprintW": 24, "footprintH": 24, "canCollide": 1 },
    "StateMachine": {
      "initial": "alive",
      "states": {
        "alive": {
          "transitions": [{ "on": "ignite", "to": "burning" }]
        },
        "burning": {
          "transitions": [
            {
              "afterTicks": 300,
              "to": "burnt",
              "effects": [
                { "name": "scorch-ground", "params": { "semantic": 9 } },
                { "name": "despawn" }
              ]
            }
          ]
        },
        "burnt": {}
      }
    }
  }
}
